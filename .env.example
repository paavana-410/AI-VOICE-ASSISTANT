# =============================================================
# AI Assistant with Memory — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# =============================================================

# --- Groq API (primary LLM — free at console.groq.com) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Gemini API (vision / image captions) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- LLM Provider: "groq" or "gemini" ---
LLM_PROVIDER=groq

# --- LlamaParse (PDF parsing — free 1000 pages/day at cloud.llamaindex.ai) ---
LLAMA_CLOUD_API_KEY=your_llamaparse_api_key_here

# --- MongoDB Atlas ---
MONGODB_ATLAS_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=ai_assistant
MEMORY_COLLECTION=mem0_memories
CONVERSATION_COLLECTION=conversation_history

# --- App Settings ---
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Comma-separated — add production URL when deploying e.g. https://yourapp.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# --- Auth (REQUIRED — server will not start without these) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
