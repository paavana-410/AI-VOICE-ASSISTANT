# =============================================================
# AI Assistant with Memory — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# =============================================================

# --- Groq API ---
# Get your free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# --- Google Gemini API ---
# Get your free key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- MongoDB Atlas ---
# Free M0 cluster connection string from https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_ATLAS_URI=your_mongodb_atlas_uri_here

# --- Database & Collection Names ---
MONGODB_DB_NAME=ai_assistant
MEMORY_COLLECTION=mem0_memories
CONVERSATION_COLLECTION=conversation_history

# --- App Settings ---
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- User / Session ---
# Default demo user id (replace with real auth in production)
DEFAULT_USER_ID=demo_user
